+/* bag2 (patch local): ponteiro de host para um trecho alocado da arena de DMA (NULL fora dela). */
+uint8_t *psx_mod_gpu_dma_host_ptr(uint32_t address, uint32_t bytes) {
+    uint32_t off;
+    if (!bytes || !mod_gpu_dma_memory_offset(address & 0x1FFFFFFFu, bytes, &off)) return NULL;
+    return mod_gpu_dma_memory + off;
+}
+
