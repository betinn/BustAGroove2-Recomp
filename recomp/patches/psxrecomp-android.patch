+#include <android/log.h>
+#include <unistd.h>
+#include <pthread.h>
+/* stdout/stderr go nowhere in an Android app: pump them through a pipe to
+ * logcat (tag psxrecomp) and to <files>/log.txt, so adb logcat and the test
+ * scripts see the same lines the PC build prints on the console. */
+static void* android_log_pump(void* arg) {
+    int fd = (int)(intptr_t)arg;
+    const char* base = SDL_GetAndroidExternalStoragePath();
+    FILE* f = nullptr;
+    if (base && base[0]) {
+        std::string p = std::string(base) + "/log.txt";
+        f = std::fopen(p.c_str(), "w");
+    }
+    char buf[4096];
+    std::string line;
+    for (;;) {
+        ssize_t n = read(fd, buf, sizeof buf);
+        if (n <= 0) break;
+        for (ssize_t i = 0; i < n; i++) {
+            if (buf[i] == '\n') {
+                __android_log_write(ANDROID_LOG_INFO, "psxrecomp", line.c_str());
+                if (f) { std::fputs(line.c_str(), f); std::fputc('\n', f); std::fflush(f); }
+                line.clear();
+            } else {
+                line.push_back(buf[i]);
+            }
+        }
+    }
+    if (f) std::fclose(f);
+    return nullptr;
+}
+static void android_redirect_stdio(void) {
+    int fds[2];
+    if (pipe(fds) != 0) return;
+    dup2(fds[1], 1);
+    dup2(fds[1], 2);
+    close(fds[1]);
+    pthread_t t;
+    if (pthread_create(&t, nullptr, android_log_pump, (void*)(intptr_t)fds[0]) == 0)
+        pthread_detach(t);
+}
+#endif
