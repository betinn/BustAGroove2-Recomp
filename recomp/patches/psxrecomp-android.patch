+
+/* Bionic declares getcontext/makecontext/swapcontext but does not implement
+ * them. Minimal cooperative context switch for AArch64: callee-saved x19..x30
+ * and d8..d15 live on the fiber's own stack; the switch saves sp into the
+ * outgoing fiber and restores the incoming one. */
+#include <stdlib.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct psx_fiber_impl {
+    void*           sp;       /* saved stack pointer while not running */
+    void*           stack;    /* NULL for the thread-fiber */
+    psx_fiber_entry entry;
+    void*           arg;
+} psx_fiber_impl;
+
+static psx_fiber_impl* s_current = NULL;
+
+void psx_fiber_swap_arm64(void** save_sp, void* new_sp);
+void psx_fiber_start_arm64(void);
+
+__asm__(
+    ".text\n"
+    ".align 4\n"
+    ".globl psx_fiber_swap_arm64\n"
+    ".type psx_fiber_swap_arm64, %function\n"
+    "psx_fiber_swap_arm64:\n"
+    "    hint #34\n"                       /* bti c */
+    "    sub  sp, sp, #176\n"
+    "    stp  x19, x20, [sp, #0]\n"
+    "    stp  x21, x22, [sp, #16]\n"
+    "    stp  x23, x24, [sp, #32]\n"
+    "    stp  x25, x26, [sp, #48]\n"
+    "    stp  x27, x28, [sp, #64]\n"
+    "    stp  x29, x30, [sp, #80]\n"
+    "    stp  d8,  d9,  [sp, #96]\n"
+    "    stp  d10, d11, [sp, #112]\n"
+    "    stp  d12, d13, [sp, #128]\n"
+    "    stp  d14, d15, [sp, #144]\n"
+    "    mov  x2, sp\n"
+    "    str  x2, [x0]\n"
+    "    mov  sp, x1\n"
+    "    ldp  x19, x20, [sp, #0]\n"
+    "    ldp  x21, x22, [sp, #16]\n"
+    "    ldp  x23, x24, [sp, #32]\n"
+    "    ldp  x25, x26, [sp, #48]\n"
+    "    ldp  x27, x28, [sp, #64]\n"
+    "    ldp  x29, x30, [sp, #80]\n"
+    "    ldp  d8,  d9,  [sp, #96]\n"
+    "    ldp  d10, d11, [sp, #112]\n"
+    "    ldp  d12, d13, [sp, #128]\n"
+    "    ldp  d14, d15, [sp, #144]\n"
+    "    add  sp, sp, #176\n"
+    "    ret\n"
+    ".size psx_fiber_swap_arm64, .-psx_fiber_swap_arm64\n"
+    ".globl psx_fiber_start_arm64\n"
+    ".type psx_fiber_start_arm64, %function\n"
+    "psx_fiber_start_arm64:\n"
+    "    hint #34\n"
+    "    mov  x0, x19\n"
+    "    bl   psx_fiber_run_c\n"
+    "    brk  #0\n"
+    ".size psx_fiber_start_arm64, .-psx_fiber_start_arm64\n"
+);
+
+void psx_fiber_run_c(psx_fiber_impl* f)
+{
+    f->entry(f->arg);
+    /* The BIOS thread entry never returns normally (see the ucontext backend). */
+    abort();
+}
+
+psx_fiber_t psx_fiber_convert_thread(void)
+{
+    if (!s_current) {
+        psx_fiber_impl* f = (psx_fiber_impl*)calloc(1, sizeof(*f));
+        f->stack = NULL;
+        s_current = f;
+    }
+    return (psx_fiber_t)s_current;
+}
+
+psx_fiber_t psx_fiber_current(void) { return (psx_fiber_t)s_current; }
+
+psx_fiber_t psx_fiber_create(size_t stack_size, psx_fiber_entry entry, void* arg)
+{
+    if (stack_size < 65536) stack_size = 65536;
+    stack_size = (stack_size + 15u) & ~(size_t)15u;
+    psx_fiber_impl* f = (psx_fiber_impl*)calloc(1, sizeof(*f));
+    if (!f) return NULL;
+    f->stack = malloc(stack_size);
+    if (!f->stack) { free(f); return NULL; }
+    f->entry = entry;
+    f->arg   = arg;
+    /* Initial frame: the 176-byte register block psx_fiber_swap_arm64 pops,
+     * with x19 = fiber and x30 = trampoline, at the top of the new stack. */
+    uintptr_t top = ((uintptr_t)f->stack + stack_size) & ~(uintptr_t)15u;
+    uint64_t* frame = (uint64_t*)(top - 176);
+    memset(frame, 0, 176);
+    frame[0]  = (uint64_t)(uintptr_t)f;                      /* x19 */
+    frame[11] = (uint64_t)(uintptr_t)psx_fiber_start_arm64;  /* x30 */
+    f->sp = frame;
+    return (psx_fiber_t)f;
+}
+
+void psx_fiber_switch(psx_fiber_t target)
+{
+    psx_fiber_impl* to   = (psx_fiber_impl*)target;
+    psx_fiber_impl* from = s_current;
+    if (!to || to == from) return;
+    s_current = to;
+    psx_fiber_swap_arm64(&from->sp, to->sp);
+}
+
+void psx_fiber_destroy(psx_fiber_t fiber)
+{
+    psx_fiber_impl* f = (psx_fiber_impl*)fiber;
+    if (!f) return;
+    free(f->stack);
+    free(f);
+}
