       fi\n          JOBS="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)"\n          # Emitters may have set PSXRECOMP_TOOLCHAIN_DIR (llvm-mingw) via\n          # GITHUB_ENV. Clear it before the MSYS2 g++ configure so the pack\'s\n          # lib/ cannot win -L for -static-libstdc++ (codecvt link errors).\n          if [[ "$(uname -s)" == MINGW* || "$(uname -s)" == MSYS* ]]; then\n            unset PSXRECOMP_TOOLCHAIN_DIR TOOLCHAIN_DIR BPE_TOOLCHAIN_DIR RETCOMM_TOOLCHAIN_DIR || true\n            unset CMAKE_PREFIX_PATH SDL3_DIR ZLIB_ROOT || true\n          fi\n          # Full game build: the committed generated/ C is REQUIRED, so a\n          # checkout without it fails configure instead of silently producing\n          # a setup host. runtime.cmake links every BIOS backend whose C is\n          # committed in the submodule (OpenBIOS; SCPH-1001 is local-only), and\n          # BIOS_STALE_FATAL refuses a stamp that predates the emitter.\n          # PSX_SETUP_WIZARD stays on: it is the first-run BIOS/disc picker.\n          # Netplay titles: set PSX_NETPLAY ON in CMakeLists *before*\n          # include(runtime.cmake) (ENABLE_NETPLAY_IF_PRESENT alone is too\n          # late) and add -DPSX_NETPLAY=ON below as belt-and-suspenders.\n          # Add title-specific -D flags here if needed (e.g. -DMOTK_NATIVE=OFF).\n          if [[ -n "${PSX_SDL3_SOURCE_DIR:-}" && -f "${PSX_SDL3_SOURCE_DIR}/CMakeLists.txt" ]]; then\n            EXTRA+=("-DFETCHCONTENT_SOURCE_DIR_SDL3=${PSX_SDL3_SOURCE_DIR}")\n          elif [[ -f "${GITHUB_WORKSPACE}/.cache/sdl3-src/CMakeLists.txt" ]]; then\n            EXTRA+=("-DFETCHCONTENT_SOURCE_DIR_SDL3=${GITHUB_WORKSPACE}/.cache/sdl3-src")\n          fi\n          cmake -S . -B build-ci -G Ninja \\\n            -DCMAKE_BUILD_TYPE=Release \\\n            -DPSXRECOMP_REQUIRE_GAME_C=ON \\\n            -DPSXRECOMP_BIOS_STALE_FATAL=ON \\\n            -DPSXRECOMP_FORCE_SETUP_HOST=OFF \\\n            -DPSXRECOMP_ALLOW_NO_BIOS=OFF \\\n            -DPSX_SETUP_WIZARD=ON \\\n            -DPSX_GAME_VERSION="${RELEASE_VERSION}" \\\n            -DPSX_RELEASE_CHANNEL="${{ github.event_name == \'push\' && \'public\' || github.event.inputs.channel }}" \\\n            "${EXTRA[@]}" 2>&1 | tee build-ci-configure.log\n          # Assert the configure took the FULL path, not the setup-host one.\n          if ! grep -q \'linking generated game C (full runtime)\' build-ci-configure.log; then\n            echo "::error::CMake did not link the generated game C (see configure log)"\n            exit 1\n          fi\n          if ! grep -qE \'BIOS backends linked: .*OpenBIOS\' build-ci-configure.log; then\n            echo "::error::CMake did not link the OpenBIOS backend (psxrecomp/generated missing or stale?)"\n            exit 1\n          fi\n          if ! grep -q \'Vulkan backend: headers\' build-ci-configure.log; then\n            echo "::error::CMake did not enable PSX_HAVE_VULKAN (see configure log)"\n            exit 1\n          fi\n          # Ninja does not emit flags.make (Makefiles generator only). Probe\n          # whichever compile-flag artifact exists for the defines the release\n          # depends on.\n          for define in PSX_HAVE_VULKAN PSX_HAS_GAME_DISPATCH; do\n            FOUND=0\n            for f in \\\n                build-ci/build.ninja \\\n                build-ci/compile_commands.json \\\n                build-ci/CMakeFiles/psx-runtime.dir/flags.make; do\n              if [[ -f "${f}" ]] && grep -q "${define}" "${f}"; then\n                FOUND=1\n                echo "Found ${define} in ${f}"\n                break\n              fi\n            done\n            if [[ "${FOUND}" -ne 1 ]]; then\n              echo "::error::${define} missing from psx-runtime compile flags"\n              exit 1\n            fi\n          done\n          cmake --build build-ci --target psx-runtime -j"${JOBS}"\n          # Lobby list pin must match RELEASE_VERSION (the packager enforces).\n          STAMP=""\n          for cand in \\\n              build-ci/psx_game_version.txt \\\n              build-ci/Release/psx_game_version.txt \\\n              build-ci/*/psx_game_version.txt\n          do\n            if [[ -f "${cand}" ]]; then STAMP="${cand}"; break; fi\n          done\n          if [[ -z "${STAMP}" ]]; then\n            STAMP="$(find build-ci -name psx_game_version.txt -type f 2>/dev/null | head -n1 || true)"\n          fi\n          if [[ -z "${STAMP}" || ! -f "${STAMP}" ]]; then\n            echo "::error::missing psx_game_version.txt after build (update psxrecomp submodule)"\n            exit 1\n          fi\n          BUILT="$(tr -d \'[:space:]\' <"${STAMP}")"\n          BUILT="${BUILT#v}"\n          if [[ "${BUILT}" != "${RELEASE_VERSION}" ]]; then\n            echo "::error::lobby pin stamp ${BUILT} != RELEASE_VERSION ${RELEASE_VERSION} (${STAMP})"\n            exit 1\n          fi\n          echo "lobby pin ok: ${BUILT} (${STAMP})"\n\n      - name: Package game zip\n        # Windows code signing (Smart App Control / SmartScreen): the packager\n        # signs the game exe and its DLLs when these secrets exist and skips\n        # signing, with a notice, when they do not. Put the .pfx in the\n        # repo\'s Actions secrets base64-encoded (`base64 -w0 cert.pfx`).\n        # See psxrecomp/docs/ci/README.md, "Windows code signing". Because the\n        # shipped exe IS the game, the signature now covers what the player\n        # runs — there is no unsigned locally built binary any more.\n        env:\n          WINDOWS_SIGN_PFX_BASE64: ${{ secrets.WINDOWS_SIGN_PFX_BASE64 }}\n          WINDOWS_SIGN_PFX_PASSWORD: ${{ secrets.WINDOWS_SIGN_PFX_PASSWORD }}\n        run: |\n          set -euo pipefail\n          chmod +x scripts/package_release.sh\n          if [[ "${{ runner.os }}" == "Windows" ]]; then\n            export PSXRECOMP_RUNTIME_BIN_DIR=/mingw64/bin\n            export BPE_RUNTIME_BIN_DIR=/mingw64/bin\n          fi\n          export RELEASE_VERSION\n          scripts/package_release.sh build-ci "${{ matrix.artifact }}" build-recompiler\n          ls -la dist/\n\n      - name: Verify zip contents\n        shell: bash\n        run: |\n          set -euo pipefail\n          # Assert the artifact, not the intent: every rule below was once\n          # "the packager does that by default" and shipped broken anyway.\n          ZIP=$(ls dist/YOUR_ZIP_PREFIX-*-"${{ matrix.artifact }}".zip | head -1)\n          echo "checking ${ZIP}"\n          LIST="$(unzip -Z1 "${ZIP}")"\n          # 1. It is a game: the executable, the bundled OpenBIOS, and the\n          #    runtime data sit at the root.\n          for must in \'bios/openbios.bin\' \'bios/OpenBIOS.LICENSE\' \'game.toml\' \'psx_game_version.txt\' \'assets/fonts/\' \'licenses/recomp-ui-LICENSE\' \'assets/fonts/NOTICE.md\' \'assets/img/NOTICE.md\' \'mods/bundled/\'; do\n            if ! grep -q "^${must}" <<<"${LIST}"; then\n              echo "::error::release zip lacks ${must}" >&2\n              printf \'%s\\n\' "${LIST}" | head -40 >&2\n              exit 1\n            fi\n          done\n          MANIFESTS=$(grep -c \'mods/bundled/.*/manifest\\.toml\' <<<"${LIST}" || true)\n          echo "mod manifests in zip: ${MANIFESTS}"\n          if [[ "${MANIFESTS}" -lt 1 ]]; then\n            echo "::error::release zip ships no mod catalog (mods/bundled/*/manifest.toml)" >&2\n            exit 1\n          fi\n          # 2. It is NOT a build kit: no framework tree, no CLI, no emitters at\n          #    the root, no sources, no generated C.\n          for never in \'^psxrecomp/\' \'^recomp-ui/\' \'^psxrecomp_cli.py\' \'^psxrecomp-game\' \'^psxrecomp-bios\' \\\n                       \'^generated/\' \'^seeds/\' \'^CMakeLists.txt\' \'^codegen_setup\\.\' \'^toolchain/\' \'^src/\'; do\n            if grep -qE "${never}" <<<"${LIST}"; then\n              echo "::error::release zip contains build-kit content matching ${never}" >&2\n              grep -E "${never}" <<<"${LIST}" | head -20 >&2\n              exit 1\n            fi\n          done\n          if grep -E \'\\.c$\' <<<"${LIST}" | grep -qv \'^overlay_toolchain/\'; then\n            echo "::error::release zip contains C sources outside overlay_toolchain/" >&2\n            grep -E \'\\.c$\' <<<"${LIST}" | grep -v \'^overlay_toolchain/\' | head -20 >&2\n            exit 1\n          fi\n          # 2b. A bundled TinyCC ships its LGPL-2.1 notice beside the binary and\n          #     in licenses/ (its win64 zip carries none of its own).\n          if grep -q \'^overlay_toolchain/tcc/tcc\\.exe$\' <<<"${LIST}"; then\n            for must in \'overlay_toolchain/tcc/COPYING\' \'licenses/TinyCC-LICENSE.txt\'; do\n              if ! grep -qx "${must}" <<<"${LIST}"; then\n                echo "::error::release zip bundles TinyCC without ${must}" >&2\n                exit 1\n              fi\n            done\n          fi\n          # 3. No BIOS dump, disc, or memory card; the only image is OpenBIOS.\n          if grep -iE \'(^|/)SCPH|\\.(cue|iso|img|chd|mcd|mcr)$\' <<<"${LIST}" | grep -qv \'\\.toml$\'; then\n            echo "::error::release zip contains a BIOS dump, disc, or memory card" >&2\n            grep -iE \'(^|/)SCPH|\\.(cue|iso|img|chd|mcd|mcr)$\' <<<"${LIST}" | grep -v \'\\.toml$\' >&2\n            exit 1\n          fi\n          if grep -iE \'\\.bin$\' <<<"${LIST}" | grep -qv \'^bios/openbios.bin$\'; then\n            echo "::error::release zip contains a .bin other than bios/openbios.bin" >&2\n            grep -iE \'\\.bin$\' <<<"${LIST}" | grep -v \'^bios/openbios.bin$\' >&2\n            exit 1\n          fi\n          # 4. Per-machine mod state never ships: state.toml is one machine\'s\n          #    selections, mods/installed/ is one developer\'s installs, and\n          #    developer-channel packages are unfinished work.\n          if grep -q \'state\\.toml\' <<<"${LIST}"; then\n            echo "::error::release zip contains mods/state.toml (per-machine state)" >&2\n            exit 1\n          fi\n          if grep -q \'mods/installed/\' <<<"${LIST}"; then\n            echo "::error::release zip contains mods/installed (per-machine installs)" >&2\n            exit 1\n          fi\n          if unzip -p "${ZIP}" \'mods/**/manifest.toml\' 2>/dev/null \\\n               | grep -Eq \'^[[:space:]]*channel[[:space:]]*=[[:space:]]*"developer"\'; then\n            echo "::error::release zip contains developer-channel mod packages" >&2\n            exit 1\n          fi\n          echo "zip verified: compiled game, bundled OpenBIOS, mod catalog, no kit / dumps / dev mods"\n\n      - name: Upload artifact\n        uses: actions/upload-artifact@v4\n        with:\n          # Artifact name uses the title zip prefix (e.g. bpe, motk).\n          name: YOUR_ZIP_PREFIX-${{ matrix.artifact }}\n          path: dist/YOUR_ZIP_PREFIX-*-${{ matrix.artifact }}.zip\n          if-no-files-found: error\n          retention-days: 30\n\n  release:\n    name: GitHub Release\n    needs: [prepare, build]\n    if: needs.prepare.outputs.publish == \'true\'\n    runs-on: ubuntu-24.04\n    steps:\n      - name: Checkout (for tagging on workflow_dispatch)\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n\n      - name: Download all artifacts\n        uses: actions/download-artifact@v4\n        with:\n          path: artifacts\n          merge-multiple: false\n\n      - name: Flatten zips\n        run: |\n          set -euo pipefail\n          mkdir -p dist\n          find artifacts -type f -name \'YOUR_ZIP_PREFIX-*.zip\' -exec cp -v {} dist/ \\;\n          ls -la dist/\n\n      - name: Ensure release tag exists\n        if: github.event_name == \'workflow_dispatch\'\n        env:\n          TAG: ${{ needs.prepare.outputs.tag }}\n        run: |\n          set -euo pipefail\n          git config user.name "github-actions[bot]"\n          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"\n          if ! git rev-parse -q --verify "refs/tags/${TAG}" >/dev/null; then\n            git tag -a "${TAG}" -m "YOUR_GAME_TITLE ${TAG}"\n          fi\n          if ! git ls-remote --exit-code --tags origin "refs/tags/${TAG}" >/dev/null 2>&1; then\n            git push origin "refs/tags/${TAG}"\n          fi\n\n      - name: Publish release\n        uses: softprops/action-gh-release@v2\n        with:\n          tag_name: ${{ needs.prepare.outputs.tag }}\n          # Quoted: titles may contain \':\' (e.g. "Marvel vs. Capcom: …").\n          name: "YOUR_GAME_TITLE ${{ needs.prepare.outputs.tag }}"\n          files: |\n            dist/YOUR_ZIP_PREFIX-*.zip\n          generate_release_notes: true\n          fail_on_unmatched_files: true\n          target_commitish: ${{ github.sha }}\n'

