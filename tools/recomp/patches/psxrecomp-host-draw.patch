+/* bag2 (patch local psxrecomp-host-draw.patch): desenho de host (mod_plugins.h). */
+int gl_renderer_host_draw(const PSXModHostDrawHeader* h, int32_t offx, int32_t offy, const void* payload);
+static PSXModHostDrawFn host_draw_fns[16];
+
+int psx_mod_register_host_draw(uint16_t id, PSXModHostDrawFn fn) {
+    if (!id || id >= 16u) return 0;
+    host_draw_fns[id] = fn;
+    return 1;
+}
+
+PSXModHostDrawFnInternal mod_host_draw_fn(uint16_t id) {
+    return id && id < 16u ? (PSXModHostDrawFnInternal)host_draw_fns[id] : NULL;
+}
+
+int mod_host_draw_marker(uint32_t source, int32_t draw_off_x, int32_t draw_off_y) {
+    unsigned i;
+    uint32_t address = source & 0x1FFFFFFFu;
+    const uint32_t hb = (uint32_t)sizeof(PSXModHostDrawHeader);
+    for (i = 0; i < arena_count; ++i) {
+        PSXModHostDrawHeader h;
+        const uint8_t* src;
+        if (address < arenas[i].begin || address - arenas[i].begin > arenas[i].size - 4u - hb) continue;
+        src = psx_mod_gpu_dma_host_ptr(source + 4u, hb);
+        if (!src) return 0;
+        memcpy(&h, src, hb);
+        if (h.magic != PSX_MOD_HOST_DRAW_MAGIC || !mod_host_draw_fn(h.id) || (h.bytes & 3u) ||
+            h.bytes > PSX_MOD_HOST_DRAW_MAX_BYTES ||
+            address - arenas[i].begin + 4u + hb + h.bytes > arenas[i].size) return 0;
+        src = h.bytes ? psx_mod_gpu_dma_host_ptr(source + 4u + hb, h.bytes) : src;
+        if (!src) return 0;
+        return gl_renderer_host_draw(&h, draw_off_x, draw_off_y, h.bytes ? src : NULL);
+    }
+    return 0;
+}
