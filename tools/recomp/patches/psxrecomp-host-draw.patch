+/* bag2 (patch local psxrecomp-host-draw.patch): desenho de host. Um pacote marcador na arena acima,
+ * ligado na OT como qualquer pacote, faz o renderizador GL chamar um callback do plugin na posição
+ * dele na ordem de desenho, com o FBO de alta resolução ligado. Layout na arena:
+ *   u32 tag (tamanho 1, como qualquer nó da OT), u32 PSX_MOD_HOST_DRAW_NOP (GP0 00h: NOP para o PS1),
+ *   PSXModHostDrawHeader, e logo depois `bytes` de payload (fora do nó: a GPU emulada não os lê).
+ * O payload é copiado por valor no fluxo da thread de render: nada de ponteiros de host na RAM do
+ * jogo, e savestate/rewind restauram a arena junto com o resto. Só OpenGL. */
+#define PSX_MOD_HOST_DRAW_NOP   0x00484452u   /* GP0 00h com "HDR" nos 24 bits baixos */
+#define PSX_MOD_HOST_DRAW_MAGIC 0x31504448u   /* "HDP1" */
+#define PSX_MOD_HOST_DRAW_MAX_BYTES (64u * 1024u)
+typedef struct PSXModHostDrawHeader {
+    uint32_t magic;          /* PSX_MOD_HOST_DRAW_MAGIC */
+    uint16_t id;             /* callback registrado (1..15) */
+    uint16_t flags;          /* livre para o plugin (repassado ao callback) */
+    uint32_t bytes;          /* tamanho do payload (múltiplo de 4, até PSX_MOD_HOST_DRAW_MAX_BYTES) */
+    int32_t  bbox[4];        /* x0, y0, x1, y1 na tela do PS1 (antes do deslocamento de desenho);
+                                x1 < x0 = nada visível (o callback roda só com pass = -1) */
+} PSXModHostDrawHeader;
+typedef struct PSXModHostDrawTarget {
+    uint32_t fbo;            /* framebuffer ligado (cor RGBA8 + profundidade/stencil 24/8); 0 em pass -1 */
+    int32_t  pass;           /* 0 superfície canônica (VRAM em alta resolução), 1 espelho da tela larga,
+                                -1 sem alvo (marcador sem nada visível: só preparar recursos) */
+    int32_t  scale;          /* pixels de host por pixel do PS1 */
+    int32_t  viewport[4];    /* já aplicado */
+    int32_t  scissor[4];     /* recorte já aplicado (pixels de host): área de desenho do jogo */
+    float    x_off, x_half;  /* posição na VRAM (pixels do PS1, já com o deslocamento de desenho) ->
+                                NDC: x = (vx + shift + x_off) / x_half - 1, y = (vy + shift) / y_half - 1 */
+    float    y_half, shift;
+    int32_t  draw_off_x, draw_off_y;   /* deslocamento de desenho (GP0 E5h) do pacote */
+    int32_t  area[4];        /* área de desenho (x1, y1, x2, y2 inclusivos, pixels do PS1 na VRAM) */
+    uint16_t flags;          /* do cabeçalho */
+    uint16_t alpha_is_mask;  /* 1: o alfa da cor é o bit 15 do PS1 (escrever 0 em pixel opaco comum) */
+    void* (*get_proc)(const char* name);   /* carregador de funções GL */
+} PSXModHostDrawTarget;
+/* Roda na thread que tem o contexto GL (a de render, ou a do jogo num ponto de sincronia). O estado
+ * GL que o renderizador espera (programa, VAO, buffers, texturas das unidades 0..7, blend,
+ * profundidade, stencil, cull, máscara de cor, recorte) é restaurado depois; o callback não pode
+ * trocar o FBO ligado nem o viewport. */
+typedef void (*PSXModHostDrawFn)(const PSXModHostDrawTarget* target, const void* payload, uint32_t bytes);
+int psx_mod_register_host_draw(uint16_t id, PSXModHostDrawFn fn);
 uint8_t psx_mod_read_byte(uint32_t address);
 void psx_mod_write_byte(uint32_t address, uint8_t value);
 uint16_t psx_mod_read_half(uint32_t address);
