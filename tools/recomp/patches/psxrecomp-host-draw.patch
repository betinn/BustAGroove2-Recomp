# Patch local do PSXRecomp para o remake (fase 1, notes/remake-plano.md): API de desenho de host para plugins.
# Aplicar em C:/tools/psxrecomp depois de psxrecomp-hd-cache-caps.patch e psxrecomp-texture-bank-render-thread.patch:
#   git apply --ignore-whitespace <este arquivo>
# Um pacote marcador na arena de pacotes (GP0 00h com "HDR") vira RTH_HOSTDRAW no fluxo da thread de render;
# no replay o callback do plugin desenha no FBO de alta resolução (e no espelho da tela larga).
--- a/runtime/include/mod_plugins.h
+++ b/runtime/include/mod_plugins.h
@@ -184,6 +184,46 @@
  * precise perspective rendering without transient host-pointer side tables.
  * Allocate during activation; do not mix stock game packets into this arena. */
