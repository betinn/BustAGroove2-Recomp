+/* ---- bag2 (patch local psxrecomp-host-draw.patch): desenho de host -------
+ * Um marcador na arena de pacotes (mod_plugins.h, PSX_MOD_HOST_DRAW_NOP) chama aqui, na thread do jogo,
+ * na posição dele na ordem de desenho. Com a thread de render o pedido vira um registro RTH_HOSTDRAW
+ * com o payload copiado por valor; no replay (ou direto, sem a thread) o callback do plugin desenha
+ * com o FBO de alta resolução ligado: primeiro a superfície canônica e, se o retângulo sai do quadro
+ * 4:3, o espelho da tela larga (como um lote de triângulos). Registro: [0] id | flags << 16,
+ * [1] bytes, [2..5] bbox na tela, [6..7] deslocamento de desenho, [8..] payload. */
+#define HOSTDRAW_HDR_INTS 8
+static uint64_t s_hostdraw_calls = 0, s_hostdraw_mirrors = 0, s_hostdraw_skipped = 0;
+static void *hostdraw_get_proc(const char *name) { return (void *)SDL_GL_GetProcAddress(name); }
+typedef struct { GLint tex2d[8], active, abuf, unpack_align, unpack_row; } HostDrawSaved;
+static void hostdraw_save(HostDrawSaved *s) {
+    glGetIntegerv(0x84E0 /* GL_ACTIVE_TEXTURE */, &s->active);
+    for (int u = 0; u < 8; u++) {
+        p_glActiveTexture(PSXGL_TEXTURE0 + u);
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &s->tex2d[u]);
+    }
+    p_glActiveTexture((GLenum)s->active);
+    glGetIntegerv(0x8894 /* GL_ARRAY_BUFFER_BINDING */, &s->abuf);
+    glGetIntegerv(GL_UNPACK_ALIGNMENT, &s->unpack_align);
+    glGetIntegerv(PSXGL_UNPACK_ROW_LENGTH, &s->unpack_row);
+}
+/* O estado que o resto do renderizador supõe fora de um desenho (hr_end e os padrões do GL); a caixa de
+ * recorte volta à do alvo (hostdraw_fill_target). */
+static void hostdraw_restore(const HostDrawSaved *s, const PSXModHostDrawTarget *t) {
+    if (t->pass >= 0) glScissor(t->scissor[0], t->scissor[1], t->scissor[2], t->scissor[3]);
+    p_glUseProgram(0);
+    p_glBindVertexArray(0);
+    p_glBindBuffer(PSXGL_ARRAY_BUFFER, (GLuint)s->abuf);
+    for (int u = 0; u < 8; u++) {
+        p_glActiveTexture(PSXGL_TEXTURE0 + u);
+        glBindTexture(GL_TEXTURE_2D, (GLuint)s->tex2d[u]);
+    }
+    p_glActiveTexture((GLenum)s->active);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, s->unpack_align);
+    glPixelStorei(PSXGL_UNPACK_ROW_LENGTH, s->unpack_row);
+    glDisable(GL_DEPTH_TEST);
+    glDepthMask(GL_TRUE);
+    glDepthFunc(GL_LESS);
+    glDisable(GL_CULL_FACE);
+    glFrontFace(GL_CCW);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glDisable(GL_BLEND);
+    glDisable(GL_STENCIL_TEST);
+}
+static void hostdraw_fill_target(PSXModHostDrawTarget *t, GLuint fbo, int pass, int scale,
+                                 int vw, int vh, float x_off, float x_half) {
+    t->fbo = fbo; t->pass = pass; t->scale = scale;
+    t->viewport[0] = 0; t->viewport[1] = 0; t->viewport[2] = vw; t->viewport[3] = vh;
+    glGetIntegerv(GL_SCISSOR_BOX, t->scissor);
+    t->x_off = x_off; t->x_half = x_half;
+}
+static void glb_host_draw(const int32_t *v) {
+    const uint16_t id = (uint16_t)(v[0] & 0xFFFF);
+    const uint32_t bytes = (uint32_t)v[1];
+    const void *payload = bytes ? (const void *)(v + HOSTDRAW_HDR_INTS) : NULL;
+    PSXModHostDrawFnInternal fn = mod_host_draw_fn(id);
+    if (!fn) return;
+    PSXModHostDrawTarget t;
+    memset(&t, 0, sizeof t);
+    t.flags = (uint16_t)((uint32_t)v[0] >> 16);
+    t.alpha_is_mask = 1;
+    t.get_proc = hostdraw_get_proc;
+    t.draw_off_x = v[6]; t.draw_off_y = v[7];
+    t.area[0] = s_area_x1; t.area[1] = s_area_y1; t.area[2] = s_area_x2; t.area[3] = s_area_y2;
+    t.y_half = 256.0f; t.shift = s_shift_hr;
+    const int x0 = v[2] + v[6], y0 = v[3] + v[7], x1 = v[4] + v[6], y1 = v[5] + v[7];
+    HostDrawSaved sv;
+    if (!s_raster_ok) { s_hostdraw_skipped++; return; }   /* antes do contexto GL */
+    /* x fora da área ainda pode cair nas margens da tela larga; só y recorta de verdade */
+    if (s_hiw || x1 < x0 || y1 < y0 || y1 < s_area_y1 || y0 > s_area_y2) {
+        s_hostdraw_skipped++;
+        hostdraw_save(&sv);
+        t.pass = -1;
+        fn(&t, payload, bytes);
+        hostdraw_restore(&sv, &t);
+        return;
+    }
+    s_hostdraw_calls++;
+    flush_flat_batch();
+    flush_tex_batch();
+    wide_stencil_ready();
+    hostdraw_save(&sv);
+    hr_begin(1);
+    hostdraw_fill_target(&t, s_hr_fbo, 0, s_hr_scale, VRAM_W * s_hr_scale, VRAM_H * s_hr_scale, 0.0f, 512.0f);
+    fn(&t, payload, bytes);
+    hostdraw_restore(&sv, &t);
+    if (g_wide_cur && s_ws_ablate != 1 && !mirror_x_center_only(x0, x1)) {
+        hiw_flush_queue();   /* espelhos já enfileirados vêm antes (ordem de pintor na superfície larga) */
+        const int dx = wide_dx();
+        p_glBindFramebuffer(PSXGL_FRAMEBUFFER, g_wide_cur);
+        glViewport(0, 0, g_wide_w * s_out_scale, VRAM_H * s_out_scale);
+        wide_band_scissor_x(view_pad_left, g_wide_w - view_pad_left - view_pad_right);
+        hostdraw_fill_target(&t, g_wide_cur, 1, s_out_scale, g_wide_w * s_out_scale, VRAM_H * s_out_scale,
+                             (float)dx, (float)g_wide_w / 2.0f);
+        fn(&t, payload, bytes);
+        hostdraw_restore(&sv, &t);
+        const float q[8] = { (float)x0, (float)y0, (float)x1, (float)y0, (float)x0, (float)y1, (float)x1, (float)y1 };
+        wst_note_draw(g_wide_cur, q, 4, 2, dx, 1.0f, 0.0f, s_mask_check);
+        s_hostdraw_mirrors++;
+    }
+    hr_end();
+    {
+        int xs[2] = { x0, x1 }, ys[2] = { y0, y1 };
+        mark_prim_dirty(xs, ys, 2, 1);
+    }
+    if (s_depth_used) DEPTH_REQUEST_CLEAR(DCLR_FILL);   /* o callback usou a profundidade do FBO */
+}
+/* gpu.c (via mod_host_draw_marker), thread do jogo. */
+int gl_renderer_host_draw(const PSXModHostDrawHeader *h, int32_t offx, int32_t offy, const void *payload) {
+    static int32_t rec[HOSTDRAW_HDR_INTS + PSX_MOD_HOST_DRAW_MAX_BYTES / 4u];
+    if (!h || h->bytes > PSX_MOD_HOST_DRAW_MAX_BYTES || (h->bytes && !payload)) return 0;
+    rec[0] = (int32_t)((uint32_t)h->id | (uint32_t)h->flags << 16);
+    rec[1] = (int32_t)h->bytes;
+    memcpy(&rec[2], h->bbox, sizeof h->bbox);
+    rec[6] = offx; rec[7] = offy;
+    if (h->bytes) memcpy(&rec[HOSTDRAW_HDR_INTS], payload, h->bytes);
+    if (rth_record_mode())
+        return rth_rec_ints(RTH_HOSTDRAW, 0, HOSTDRAW_HDR_INTS + (int)(h->bytes / 4u), rec);
+    glb_host_draw(rec);
+    return 1;
+}
+uint64_t gl_renderer_host_draw_stats(uint64_t *mirrors, uint64_t *skipped) {
+    if (mirrors) *mirrors = s_hostdraw_mirrors;
+    if (skipped) *skipped = s_hostdraw_skipped;
+    return s_hostdraw_calls;
+}
+
